{
  "$schema": "https://opencode.ai/config.json",

  "model": "openai/gpt-5.6-sol",

  "plugin": [
    "oh-my-openagent"
  ],

  "permission": {
    "read": {
      ".env": "ask",
      ".envrc": "ask"
    }
  },

  "watcher": {
    "ignore": [
      "node_modules/**",
      ".venv/**",
      "dist/**",
      ".git/**",
      ".pytest_cache/**",
      ".ruff_cache/**"
    ]
  }
}
