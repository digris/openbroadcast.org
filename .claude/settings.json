{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git rev-parse:*)",
      "Bash(git worktree list:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git switch:*)",
      "Bash(uv sync:*)",
      "Bash(uv add:*)",
      "Bash(uv lock:*)",
      "Bash(bun install:*)",
      "Bash(bun add:*)",
      "Bash(bun run lint:*)",
      "Bash(bun run format:*)",
      "Bash(bun run build:*)",
      "Bash(bun run typecheck:*)",
      "Bash(make setup:*)",
      "Bash(make lint:*)",
      "Bash(make lint-be:*)",
      "Bash(make lint-fe:*)",
      "Bash(make format:*)",
      "Bash(make format-be:*)",
      "Bash(make format-fe:*)",
      "Bash(make test-be:*)",
      "Bash(make check-version:*)",
      "Bash(make up:*)",
      "Bash(make down:*)",
      "Bash(make logs:*)",
      "Bash(make ps:*)",
      "Bash(docker compose:*)",
      "Bash(docker ps:*)",
      "Bash(make smoke:*)",
      "Bash(make -C infra/terraform fmt:*)",
      "Bash(make -C infra/terraform lint:*)",
      "Bash(make -C infra/terraform validate:*)",
      "Bash(make -C infra/deploy help:*)",
      "Bash(make -C infra/deploy lock:*)",
      "Bash(make -C infra/deploy pack-local:*)",
      "Bash(ls:*)",
      "Read(ref/**)",
      "Bash(scripts/refs.sh:*)",
      "Bash(./scripts/refs.sh:*)"
    ],
    "ask": [
      "Bash(make release:*)",
      "Bash(make build:*)",
      "Bash(make provision:*)",
      "Bash(make deploy:*)",
      "Bash(make release-build-deploy:*)",
      "Bash(make smoke-prod:*)",
      "Bash(make gcp-:*)",
      "Bash(make -C infra/deploy build:*)",
      "Bash(make -C infra/deploy provision:*)",
      "Bash(make -C infra/deploy deploy:*)",
      "Bash(make -C infra/terraform init:*)",
      "Bash(make -C infra/terraform plan:*)",
      "Bash(make -C infra/terraform apply:*)",
      "Bash(tofu apply:*)",
      "Bash(tofu -chdir=infra/terraform apply:*)",
      "Bash(terraform apply:*)",
      "Bash(gcloud:*)"
    ],
    "deny": [
      "Edit(ref/**)",
      "Write(ref/**)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.prod)",
      "Read(**/.env.*.local)",
      "Read(**/.envrc)",
      "Read(.gcp/**)",
      "Bash(git push:*)",
      "Bash(uv run ruff:*)",
      "Bash(uv run pytest:*)",
      "Bash(env)",
      "Bash(printenv:*)",
      "Bash(direnv dump:*)"
    ]
  },
  "claudeMdExcludes": [
    "**/ref/**/CLAUDE.md",
    "**/ref/**/.claude/**"
  ]
}
