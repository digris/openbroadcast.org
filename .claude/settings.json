{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git rev-parse:*)",
      "Bash(git worktree list:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git switch:*)",
      "Bash(uv sync:*)",
      "Bash(uv add:*)",
      "Bash(uv lock:*)",
      "Bash(bun install:*)",
      "Bash(bun add:*)",
      "Bash(bun run build:*)",
      "Bash(make setup:*)",
      "Bash(make lint:*)",
      "Bash(make lint-be:*)",
      "Bash(make lint-fe:*)",
      "Bash(make format:*)",
      "Bash(make format-be:*)",
      "Bash(make format-fe:*)",
      "Bash(make test:*)",
      "Bash(make test-be:*)",
      "Bash(make test-be-fast:*)",
      "Bash(make build-fe:*)",
      "Bash(make up:*)",
      "Bash(make down:*)",
      "Bash(make logs:*)",
      "Bash(make ps:*)",
      "Bash(docker compose:*)",
      "Bash(docker ps:*)",
      "Bash(ls:*)",
      "Read(ref/**)"
    ],
    "ask": [
      "Bash(make cli:*)"
    ],
    "deny": [
      "Edit(ref/**)",
      "Write(ref/**)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.envrc)",
      "Bash(git push:*)",
      "Bash(uv run ruff:*)",
      "Bash(uv run pytest:*)",
      "Bash(env)",
      "Bash(printenv:*)",
      "Bash(direnv dump:*)"
    ]
  },
  "claudeMdExcludes": [
    "**/ref/**/CLAUDE.md",
    "**/ref/**/.claude/**"
  ]
}
