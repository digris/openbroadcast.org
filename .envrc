export DJANGO_SETTINGS_MODULE=config.settings.dev

export PYTHONPYCACHEPREFIX=/tmp/.pycache

export BUILDKIT_PROGRESS=plain

export OMO_SEND_ANONYMOUS_TELEMETRY=0
export OMO_DISABLE_POSTHOG=1


# apple silicon
if [ "$(uname -s)" = "Darwin" ] && [ "$(uname -m)" = "arm64" ]; then
    # python-magic / libmagic
    export DYLD_LIBRARY_PATH="$(brew --prefix libmagic)/lib${DYLD_LIBRARY_PATH:+:$DYLD_LIBRARY_PATH}"
    # Wand / ImageMagick
    export MAGICK_HOME="$(brew --prefix imagemagick)"
fi

# omx hack in case of problems (cargo build -p omx-runtime in oh-my-codex and adjust paths accordingly)
# export PATH="$HOME/.nvm/versions/node/v22.21.1/lib/node_modules/oh-my-codex/target/debug:$PATH"

ENV=.env
if test -f "$ENV"; then
    set -a
    source "$ENV"
    set +a
fi
